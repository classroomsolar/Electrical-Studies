+const T2=[[20,[4.0,2.0,1.5,0.6,0.3],5.0],[50,[7.0,3.5,2.5,1.0,0.5],8.0],[100,[10.0,4.5,4.0,1.5,0.7],12.0],[1000,[12.0,5.5,5.0,2.0,1.0],15.0],[Infinity,[15.0,7.0,6.0,2.5,1.4],20.0]];
