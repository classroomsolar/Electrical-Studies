+// V31 Build plant + Equipment table dialogs. All changes go through the Studio hook (validation, undo,
+// draft save, project-folder autosave and recalculation).
+import {BUILDER_FIELDS,BUILDER_OPTIONS,validateSpec,estimateCounts,buildPlant,equipmentCsv,applyEquipmentCsv} from './plant-builder.mjs?v=20261108-v31';
+import {emptyProject} from './network-model.mjs?v=20261022-pv-final';
+const KEY='fcs-plant-builder-v31';
+const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const studio=()=>{const s=globalThis.__fcsStudio;if(!s)throw Error('The Studio is still loading. Try again in a moment.');return s};
+function saved(){try{return JSON.parse(localStorage.getItem(KEY)||'{}')||{}}catch{return {}}}
+function dialog(id,title,body){
+ document.getElementById(id)?.remove();
+ const d=document.createElement('dialog');d.id=id;d.className='v31-dialog';d.setAttribute('aria-labelledby',id+'-title');
+ d.innerHTML=`<form method="dialog" class="v31-dialog-form"><header><h2 id="${id}-title">${esc(title)}</h2><button type="button" class="v31-close" data-v31-close aria-label="Close">×</button></header><div class="v31-dialog-body">${body}</div></form>`;
+ document.body.appendChild(d);d.addEventListener('click',e=>{if(e.target.closest('[data-v31-close]'))d.close()});d.addEventListener('close',()=>d.remove());d.showModal();return d;
+}
+function readSpec(d){
+ const spec={};for(const [k,,unit] of BUILDER_FIELDS){const raw=d.querySelector(`[name="${k}"]`).value.trim();spec[k]=raw===''?null:Number(raw.replace(/,/g,''));if(unit==='count'&&spec[k]!==null&&!Number.isFinite(spec[k]))spec[k]=NaN}
+ for(const [k] of BUILDER_OPTIONS)spec[k]=d.querySelector(`[name="${k}"]`).checked;return spec;
+}
+function openBuilder(){
+ const last=saved();
+ const fields=BUILDER_FIELDS.map(([k,label,unit,req])=>`<div class="field"><label for="pb-${k}">${esc(label)}${unit&&unit!=='count'?` <span class="v31-unit">${esc(unit)}</span>`:''}${req?'':' <span class="v31-optional">optional</span>'}</label><input id="pb-${k}" name="${k}" inputmode="decimal" autocomplete="off" value="${esc(last[k]??'')}"></div>`).join('');
+ const opts=BUILDER_OPTIONS.map(([k,label])=>`<label class="v31-check"><input type="checkbox" name="${k}" ${last[k]??(k!=='bess')?'checked':''}> ${esc(label)}</label>`).join('');
+ const d=dialog('v31-plant-builder','Build a plant one-line',`<p class="v31-lead">Enter your plant’s block data. The builder repeats your block for every feeder position and connects it to the collector. Every impedance and fault value comes from your entries; protective-device ratings start blank for you to fill in (single item or Equipment table).</p>
+  <div class="v31-grid">${fields}</div><fieldset class="v31-options"><legend>Protective devices and sources</legend>${opts}</fieldset>
+  <fieldset class="v31-options"><legend>Where to put it</legend><label class="v31-check"><input type="radio" name="mode" value="new" checked> Start a new project with this plant</label><label class="v31-check"><input type="radio" name="mode" value="add"> Add to the open project, below its one-line</label></fieldset>
+  <p class="v31-summary" role="status" id="pb-summary"></p><ul class="v31-errors" id="pb-errors"></ul>
+  <footer><button type="button" data-v31-close>Cancel</button><button type="button" class="primary" id="pb-build">Build one-line</button></footer>`);
+ const update=()=>{const spec=readSpec(d),errors=validateSpec(spec),c=estimateCounts(spec);d.querySelector('#pb-summary').textContent=errors.length?'':`${c.blocks} blocks · ${c.inverters} ${spec.bess?'battery inverters':'inverters'} · ${c.buses} buses · ${c.devices} protective devices · ${c.sources} sources`;return {spec,errors}};
